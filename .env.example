# Copy to .env for local development. Never commit .env.
NODE_ENV=development
WEB_ORIGIN=http://localhost:8020
API_PORT=8120
API_URL=http://localhost:8120

DATABASE_URL=postgresql://docrequest:docrequest@localhost:5432/docrequest
REDIS_URL=redis://localhost:6379/6
REDIS_PREFIX=docrequest:

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Secret used to hash one-time codes in Redis. openssl rand -base64 32
CODE_PEPPER=change-me-to-another-long-random-string

SIGNUP_ENABLED=true
DEMO_MODE=false

# Email: "file" writes .eml files to MAIL_DIR (no real email); "smtp" sends.
MAIL_DRIVER=file
MAIL_DIR=./storage/mail
MAIL_FROM="DocRequest <no-reply@localhost>"
SMTP_URL=smtp://localhost:1025
