# Copy to deploy.env (git-ignored) and fill in. Never commit server details: this repo is public.
# SSH alias (in ~/.ssh/config) that logs in as the site user with a key.
SSH_HOST=your-ssh-alias
# Where releases live on the server, and where database backups go.
APP_DIR=/path/to/app
BACKUP_DIR=/path/to/backups
# Public URL, checked after each deploy.
SITE_URL=https://example.com
# Local ports the apps listen on (127.0.0.1 only; nginx proxies to them).
WEB_PORT=3000
API_PORT=4000
# Must match MAX_UPLOAD_MB in the server's api.env (baked into the web build).
MAX_UPLOAD_MB=20
# PM2 process name prefix and memory limits.
PM2_PREFIX=docrequest
WEB_MAX_MEMORY=400M
API_MAX_MEMORY=400M
WORKER_MAX_MEMORY=500M
